# Copy to secrets/emqx.env and fill in HOST. Used by cloud/test-broker.sh.
# The real file lives in secrets/ (ignored by git).
NAME=emqx-serverless
HOST=xxxxxxxx.ala.eu-central-1.emqxsl.com
PORT=8883
CAFILE=secrets/emqx-ca.pem
# Unrelated CA, for the "untrusted certificate is refused" test (created by cloud/mosquitto/setup.sh)
WRONG_CAFILE=cloud/mosquitto/certs/wrong-ca.crt
DEVICE_USER=vigil-device
DEVICE_PASS_FILE=secrets/vigil-device.pass
APP_USER=vigil-app
APP_PASS_FILE=secrets/vigil-app.pass
