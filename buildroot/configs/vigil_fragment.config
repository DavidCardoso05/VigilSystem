# VigilSystem additions on top of raspberrypi4_64_defconfig (Buildroot 2026.08).
# Merged with: support/kconfig/merge_config.sh -m .config <this file> && make olddefconfig
# The full result is saved in vigil_rpi4_defconfig (make savedefconfig).

BR2_DEFCONFIG="/home/david/VigilSystem/buildroot/configs/vigil_rpi4_defconfig"

# System
BR2_TARGET_GENERIC_HOSTNAME="vigil"
BR2_TARGET_GENERIC_ISSUE="Welcome to VigilSystem"
BR2_ROOTFS_OVERLAY="/home/david/VigilSystem/buildroot/overlay"
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"

# TLS + MQTT 5 (Paho enables SSL only when OpenSSL is selected)
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_PAHO_MQTT_C=y
BR2_PACKAGE_PAHO_MQTT_CPP=y

# Wi-Fi (the stock Pi 4 defconfig has none)
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI=y

# Clock: the Pi has no RTC, TLS needs the right time
BR2_PACKAGE_CHRONY=y

# Application libraries
BR2_PACKAGE_SQLITE=y
BR2_PACKAGE_JSON_FOR_MODERN_CPP=y

# Hardware access and debugging (keypad/sensors via libgpiod, INA219 via I2C).
# libgpiod v1: libgpiod2 needs kernel headers >= 5.10, the Bootlin stable toolchain has 5.4.
BR2_PACKAGE_LIBGPIOD=y
BR2_PACKAGE_LIBGPIOD_TOOLS=y
BR2_PACKAGE_I2C_TOOLS=y

# Remote login
BR2_PACKAGE_DROPBEAR=y
